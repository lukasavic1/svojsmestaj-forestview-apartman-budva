# Copy to .env.local and fill in. Never commit real keys.
# Switching to the client's calendar later: change GOOGLE_CALENDAR_ID only
# (and share that calendar with the same service account).

# Google Service Account Credentials
GOOGLE_CLIENT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Calendar ID (personal for testing, then the client's calendar ID)
GOOGLE_CALENDAR_ID="your_personal_calendar_id@group.calendar.google.com"
