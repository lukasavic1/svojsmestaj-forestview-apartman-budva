# Copy to .env.local and fill in. Never commit secrets.

# Google Calendar → Settings → the listing calendar → Integrate calendar
# → "Secret address in iCal format"
CALENDAR_ICS_URL="https://calendar.google.com/calendar/ical/your-secret-ical/private-xxx/basic.ics"

# Resend — email the host about a potential reservation
# API key: https://resend.com/api-keys
# Verify your domain, then set FROM to e.g. Forest View Budva <upiti@yourdomain.com>
# Until then, onboarding@resend.dev only delivers to your Resend account email.
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM="Forest View Budva <onboarding@resend.dev>"
HOST_EMAIL="host@example.com"
